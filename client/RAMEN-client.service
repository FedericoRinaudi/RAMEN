[Unit]
Description=RAMEN Client Daemon
Documentation=https://github.com/FedericoRinaudi/RAMEN
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/RAMEN
ExecStart=/usr/local/bin/RAMEN-client
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

NoNewPrivileges=false
PrivateTmp=false
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/RAMEN /var/log/RAMEN /tmp
CapabilityBoundingSet=CAP_NET_ADMIN CAP_BPF CAP_SYS_ADMIN CAP_SYS_RESOURCE
AmbientCapabilities=CAP_NET_ADMIN CAP_BPF CAP_SYS_ADMIN CAP_SYS_RESOURCE

LimitNOFILE=65536
LimitNPROC=512

[Install]
WantedBy=multi-user.target
